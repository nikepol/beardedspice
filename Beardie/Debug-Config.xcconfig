// if DEBUG_STRATEGY set to 1,
// then Beardie uses strategies only from bundle resources folder.
DEBUG_STRATEGY = 1


#include "./Config.xcconfig"

// Macro definition
GCC_PREPROCESSOR_DEFINITIONS = BS_STRATEGY_EXTENSION=@\"$(BS_STRATEGY_EXTENSION)\" DEBUG_STRATEGY=$(DEBUG_STRATEGY)

